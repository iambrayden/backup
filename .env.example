# ── Core ──────────────────────────────────────────────────────────────────────
PLATFORM_DOMAIN=backup.waylontech.com

# Generate with: openssl rand -base64 32
MASTER_KEY=REPLACE_WITH_BASE64_32_BYTES
JWT_SECRET=REPLACE_WITH_BASE64_32_BYTES

# ── Database ───────────────────────────────────────────────────────────────────
POSTGRES_USER=backup
POSTGRES_PASSWORD=backup
POSTGRES_DB=backup
DATABASE_URL=postgres://backup:backup@postgres:5432/backup?sslmode=disable

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Bootstrap admin (created on first run if no users exist) ─────────────────
ADMIN_EMAIL=admin@waylontech.com
ADMIN_PASSWORD=changeme-in-prod

# ── Default storage target seeded at bootstrap ────────────────────────────────
# Points at the bundled MinIO instance. Override for a real provider.
DEFAULT_STORAGE_ENDPOINT=http://minio:9000
DEFAULT_STORAGE_BUCKET=backup
DEFAULT_STORAGE_REGION=us-east-1
DEFAULT_STORAGE_ACCESS_KEY=minioadmin
DEFAULT_STORAGE_SECRET_KEY=minioadmin
DEFAULT_STORAGE_PATH_STYLE=true

# ── MinIO (dev only) ──────────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ── Web UI ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080
